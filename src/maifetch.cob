*> AI-assisted with OpenAI GPT-5 Codex.
       >>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. maifetch.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT DATA-FILE ASSIGN TO DYNAMIC WS-FILE-PATH
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-FILE-STATUS.

DATA DIVISION.
FILE SECTION.
FD DATA-FILE.
01 DATA-LINE PIC X(4096).

WORKING-STORAGE SECTION.
01 WS-CONFIG.
   05 WS-ACCESS-TOKEN PIC X(512) VALUE SPACES.
   05 WS-CONFIG-PATH PIC X(512) VALUE SPACES.
   05 WS-BASE-URL PIC X(256) VALUE "https://maitea.app".
   05 WS-LOGO-SIZE PIC S9(4) COMP-5 VALUE 20.
   05 WS-SCORE-COUNT PIC 9(4) COMP-5 VALUE 4.

01 WS-FILES.
   05 WS-FILE-PATH PIC X(512) VALUE SPACES.
   05 WS-FILE-STATUS PIC XX VALUE "00".
   05 WS-READ-PATH PIC X(512) VALUE SPACES.
   05 WS-READ-BUFFER PIC X(65536) VALUE SPACES.
   05 WS-TEMP-BUFFER PIC X(65536) VALUE SPACES.
   05 WS-CONFIG-JSON PIC X(65536) VALUE SPACES.
   05 WS-PROFILE-JSON PIC X(65536) VALUE SPACES.
   05 WS-PLAYS-JSON PIC X(65536) VALUE SPACES.

01 WS-ENV.
   05 WS-ENV-NAME PIC X(80) VALUE SPACES.
   05 WS-ENV-VALUE PIC X(1024) VALUE SPACES.
   05 WS-HOME PIC X(512) VALUE SPACES.
   05 WS-XDG PIC X(512) VALUE SPACES.
   05 WS-APPDATA PIC X(512) VALUE SPACES.

01 WS-ARGS.
   05 WS-ARG-COUNT PIC 9(4) COMP-5 VALUE 0.
   05 WS-ARG-INDEX PIC 9(4) COMP-5 VALUE 0.
   05 WS-ARG-TEXT PIC X(512) VALUE SPACES.
   05 WS-ARG-VALUE PIC X(512) VALUE SPACES.

01 WS-HTTP.
   05 WS-PROFILE-PATH PIC X(512) VALUE "maifetch-profiles.json".
   05 WS-PLAYS-PATH PIC X(512) VALUE "maifetch-plays.json".
   05 WS-COMMAND PIC X(4096) VALUE SPACES.
   05 WS-SYSTEM-COMMAND PIC X(4096) VALUE SPACES.
   05 WS-RETURN-CODE PIC S9(9) COMP-5 VALUE 0.

01 WS-PROFILE.
   05 WS-PROFILE-ID PIC 9(9) COMP-5 VALUE 0.
   05 WS-PROFILE-NAME PIC X(128) VALUE SPACES.
   05 WS-PROFILE-RATING PIC 9(9) COMP-5 VALUE 0.
   05 WS-PROFILE-RATING-HIGH PIC 9(9) COMP-5 VALUE 0.
   05 WS-PROFILE-LEVEL PIC 9(9) COMP-5 VALUE 0.
   05 WS-PROFILE-TOTAL PIC 9(9) COMP-5 VALUE 0.
   05 WS-PROFILE-ICON PIC X(512) VALUE SPACES.

01 WS-PLAY-TABLE.
   05 WS-PLAY-COUNT PIC 9(4) COMP-5 VALUE 0.
   05 WS-PLAY OCCURS 12 TIMES.
      10 WS-PLAY-SONG PIC X(160) VALUE SPACES.
      10 WS-PLAY-DIFF PIC X(32) VALUE SPACES.
      10 WS-PLAY-SCORE PIC X(64) VALUE SPACES.
      10 WS-PLAY-ACHIEVEMENT PIC X(64) VALUE SPACES.
      10 WS-PLAY-RANK PIC X(32) VALUE SPACES.
      10 WS-PLAY-FC PIC X(32) VALUE SPACES.

01 WS-JSON.
   05 WS-JSON-SOURCE PIC X(65536) VALUE SPACES.
   05 WS-JSON-LEN PIC 9(9) COMP-5 VALUE 0.
   05 WS-KEY PIC X(80) VALUE SPACES.
   05 WS-KEY-LEN PIC 9(4) COMP-5 VALUE 0.
   05 WS-START-POS PIC 9(9) COMP-5 VALUE 1.
   05 WS-FOUND-POS PIC 9(9) COMP-5 VALUE 1.
   05 WS-AFTER-POS PIC 9(9) COMP-5 VALUE 1.
   05 WS-SCAN-POS PIC 9(9) COMP-5 VALUE 1.
   05 WS-OUT-POS PIC 9(4) COMP-5 VALUE 1.
   05 WS-FOUND PIC X VALUE "N".
   05 WS-EXTRACTED PIC X(1024) VALUE SPACES.
   05 WS-NUMERIC-TEXT PIC X(64) VALUE SPACES.

01 WS-OUTPUT.
   05 WS-IDX PIC 9(4) COMP-5 VALUE 0.
   05 WS-RATING PIC 9999V99 VALUE 0.
   05 WS-RATING-HIGH PIC 9999V99 VALUE 0.
   05 WS-ID-TEXT PIC Z(8)9.
   05 WS-LEVEL-TEXT PIC Z(8)9.
   05 WS-TOTAL-TEXT PIC Z(8)9.
   05 WS-RATING-TEXT PIC ZZ9.99.
   05 WS-RATING-HIGH-TEXT PIC ZZ9.99.
   05 WS-LOGO-WIDTH PIC 9(4) COMP-5 VALUE 0.
   05 WS-PADDING PIC X(256) VALUE SPACES.
   05 WS-PRINT-LINE PIC X(1024) VALUE SPACES.

PROCEDURE DIVISION.
MAIN.
    PERFORM LOAD-DEFAULT-CONFIG
    PERFORM READ-CONFIG-PATH-FROM-ARGS
    PERFORM READ-CONFIG-FILE
    PERFORM READ-ENVIRONMENT
    PERFORM READ-FINAL-ARGS
    PERFORM VALIDATE-CONFIG
    PERFORM LOAD-API-DATA
    PERFORM PARSE-PROFILE
    PERFORM PARSE-PLAYS
    PERFORM PRINT-REPORT
    STOP RUN.

LOAD-DEFAULT-CONFIG.
    MOVE "MAITEA_CONFIG_FILE" TO WS-ENV-NAME
    PERFORM GET-ENV
    IF FUNCTION TRIM(WS-ENV-VALUE) NOT = ""
        MOVE WS-ENV-VALUE TO WS-CONFIG-PATH
    END-IF

    IF FUNCTION TRIM(WS-CONFIG-PATH) = ""
        MOVE "APPDATA" TO WS-ENV-NAME
        PERFORM GET-ENV
        MOVE WS-ENV-VALUE TO WS-APPDATA
        MOVE "XDG_CONFIG_HOME" TO WS-ENV-NAME
        PERFORM GET-ENV
        MOVE WS-ENV-VALUE TO WS-XDG
        MOVE "HOME" TO WS-ENV-NAME
        PERFORM GET-ENV
        MOVE WS-ENV-VALUE TO WS-HOME

        IF FUNCTION TRIM(WS-APPDATA) NOT = ""
            STRING FUNCTION TRIM(WS-APPDATA) "/maifetch.json"
                DELIMITED BY SIZE INTO WS-CONFIG-PATH
        ELSE
            IF FUNCTION TRIM(WS-XDG) NOT = ""
                STRING FUNCTION TRIM(WS-XDG) "/maifetch.json"
                    DELIMITED BY SIZE INTO WS-CONFIG-PATH
            ELSE
                IF FUNCTION TRIM(WS-HOME) NOT = ""
                    STRING FUNCTION TRIM(WS-HOME) "/.config/maifetch.json"
                        DELIMITED BY SIZE INTO WS-CONFIG-PATH
                ELSE
                    MOVE "maifetch.json" TO WS-CONFIG-PATH
                END-IF
            END-IF
        END-IF
    END-IF.

READ-CONFIG-PATH-FROM-ARGS.
    ACCEPT WS-ARG-COUNT FROM ARGUMENT-NUMBER
    PERFORM VARYING WS-ARG-INDEX FROM 1 BY 1
        UNTIL WS-ARG-INDEX > WS-ARG-COUNT
        DISPLAY WS-ARG-INDEX UPON ARGUMENT-NUMBER
        ACCEPT WS-ARG-TEXT FROM ARGUMENT-VALUE
        IF WS-ARG-TEXT(1:14) = "--config-file="
            MOVE WS-ARG-TEXT(15:) TO WS-CONFIG-PATH
        ELSE
            IF WS-ARG-TEXT = "--config-file" OR WS-ARG-TEXT = "-c"
                ADD 1 TO WS-ARG-INDEX
                IF WS-ARG-INDEX <= WS-ARG-COUNT
                    DISPLAY WS-ARG-INDEX UPON ARGUMENT-NUMBER
                    ACCEPT WS-ARG-VALUE FROM ARGUMENT-VALUE
                    MOVE WS-ARG-VALUE TO WS-CONFIG-PATH
                END-IF
            END-IF
        END-IF
    END-PERFORM.

READ-CONFIG-FILE.
    IF FUNCTION TRIM(WS-CONFIG-PATH) = ""
        EXIT PARAGRAPH
    END-IF
    MOVE WS-CONFIG-PATH TO WS-READ-PATH
    PERFORM READ-FILE-OPTIONAL
    MOVE WS-READ-BUFFER TO WS-CONFIG-JSON
    IF FUNCTION TRIM(WS-CONFIG-JSON) NOT = ""
        MOVE WS-CONFIG-JSON TO WS-JSON-SOURCE
        MOVE 1 TO WS-START-POS
        MOVE '"accessToken"' TO WS-KEY
        PERFORM EXTRACT-STRING
        IF WS-FOUND = "Y"
            MOVE WS-EXTRACTED TO WS-ACCESS-TOKEN
        END-IF

        MOVE 1 TO WS-START-POS
        MOVE '"scoreCount"' TO WS-KEY
        PERFORM EXTRACT-NUMBER
        IF WS-FOUND = "Y"
            MOVE FUNCTION NUMVAL(WS-NUMERIC-TEXT) TO WS-SCORE-COUNT
        END-IF

        MOVE 1 TO WS-START-POS
        MOVE '"logoSize"' TO WS-KEY
        PERFORM EXTRACT-NUMBER
        IF WS-FOUND = "Y"
            MOVE FUNCTION NUMVAL(WS-NUMERIC-TEXT) TO WS-LOGO-SIZE
        END-IF
    END-IF.

READ-ENVIRONMENT.
    MOVE "MAITEA_TOKEN" TO WS-ENV-NAME
    PERFORM GET-ENV
    IF FUNCTION TRIM(WS-ENV-VALUE) NOT = ""
        MOVE WS-ENV-VALUE TO WS-ACCESS-TOKEN
    END-IF

    MOVE "MAITEA_SCORE_COUNT" TO WS-ENV-NAME
    PERFORM GET-ENV
    IF FUNCTION TRIM(WS-ENV-VALUE) NOT = ""
        MOVE FUNCTION NUMVAL(WS-ENV-VALUE) TO WS-SCORE-COUNT
    END-IF

    MOVE "MAITEA_LOGO_SIZE" TO WS-ENV-NAME
    PERFORM GET-ENV
    IF FUNCTION TRIM(WS-ENV-VALUE) NOT = ""
        MOVE FUNCTION NUMVAL(WS-ENV-VALUE) TO WS-LOGO-SIZE
    END-IF.

READ-FINAL-ARGS.
    ACCEPT WS-ARG-COUNT FROM ARGUMENT-NUMBER
    PERFORM VARYING WS-ARG-INDEX FROM 1 BY 1
        UNTIL WS-ARG-INDEX > WS-ARG-COUNT
        DISPLAY WS-ARG-INDEX UPON ARGUMENT-NUMBER
        ACCEPT WS-ARG-TEXT FROM ARGUMENT-VALUE
        EVALUATE TRUE
            WHEN WS-ARG-TEXT = "--help" OR WS-ARG-TEXT = "-h"
                PERFORM PRINT-HELP
                STOP RUN
            WHEN WS-ARG-TEXT(1:15) = "--access-token="
                MOVE WS-ARG-TEXT(16:) TO WS-ACCESS-TOKEN
            WHEN WS-ARG-TEXT = "--access-token"
              OR WS-ARG-TEXT = "-a"
              OR WS-ARG-TEXT = "-t"
                PERFORM ACCEPT-NEXT-ARG
                MOVE WS-ARG-VALUE TO WS-ACCESS-TOKEN
            WHEN WS-ARG-TEXT(1:12) = "--logo-size="
                MOVE FUNCTION NUMVAL(WS-ARG-TEXT(13:)) TO WS-LOGO-SIZE
            WHEN WS-ARG-TEXT = "--logo-size"
              OR WS-ARG-TEXT = "-l"
                PERFORM ACCEPT-NEXT-ARG
                MOVE FUNCTION NUMVAL(WS-ARG-VALUE) TO WS-LOGO-SIZE
            WHEN WS-ARG-TEXT(1:14) = "--score-count="
                MOVE FUNCTION NUMVAL(WS-ARG-TEXT(15:)) TO WS-SCORE-COUNT
            WHEN WS-ARG-TEXT = "--score-count"
              OR WS-ARG-TEXT = "-s"
                PERFORM ACCEPT-NEXT-ARG
                MOVE FUNCTION NUMVAL(WS-ARG-VALUE) TO WS-SCORE-COUNT
            WHEN WS-ARG-TEXT(1:14) = "--config-file="
                MOVE WS-ARG-TEXT(15:) TO WS-CONFIG-PATH
            WHEN WS-ARG-TEXT = "--config-file"
              OR WS-ARG-TEXT = "-c"
                PERFORM ACCEPT-NEXT-ARG
                MOVE WS-ARG-VALUE TO WS-CONFIG-PATH
            WHEN WS-ARG-TEXT(1:11) = "--base-url="
                MOVE WS-ARG-TEXT(12:) TO WS-BASE-URL
        END-EVALUATE
    END-PERFORM.

ACCEPT-NEXT-ARG.
    ADD 1 TO WS-ARG-INDEX
    IF WS-ARG-INDEX <= WS-ARG-COUNT
        DISPLAY WS-ARG-INDEX UPON ARGUMENT-NUMBER
        ACCEPT WS-ARG-VALUE FROM ARGUMENT-VALUE
    ELSE
        MOVE SPACES TO WS-ARG-VALUE
    END-IF.

VALIDATE-CONFIG.
    IF FUNCTION TRIM(WS-ACCESS-TOKEN) = ""
        DISPLAY "access token is required" UPON STDERR
        STOP RUN RETURNING 1
    END-IF
    IF WS-SCORE-COUNT > 12
        DISPLAY "score count cannot be higher than 12" UPON STDERR
        STOP RUN RETURNING 1
    END-IF
    IF WS-SCORE-COUNT = 0
        MOVE 1 TO WS-SCORE-COUNT
    END-IF.

LOAD-API-DATA.
    MOVE "MAIFETCH_PROFILE_FIXTURE" TO WS-ENV-NAME
    PERFORM GET-ENV
    IF FUNCTION TRIM(WS-ENV-VALUE) NOT = ""
        MOVE WS-ENV-VALUE TO WS-PROFILE-PATH
        MOVE WS-PROFILE-PATH TO WS-READ-PATH
        PERFORM READ-FILE-REQUIRED
        MOVE WS-READ-BUFFER TO WS-PROFILE-JSON
    ELSE
        PERFORM FETCH-PROFILES
        MOVE WS-PROFILE-PATH TO WS-READ-PATH
        PERFORM READ-FILE-REQUIRED
        MOVE WS-READ-BUFFER TO WS-PROFILE-JSON
    END-IF

    MOVE "MAIFETCH_PLAYS_FIXTURE" TO WS-ENV-NAME
    PERFORM GET-ENV
    IF FUNCTION TRIM(WS-ENV-VALUE) NOT = ""
        MOVE WS-ENV-VALUE TO WS-PLAYS-PATH
        MOVE WS-PLAYS-PATH TO WS-READ-PATH
        PERFORM READ-FILE-REQUIRED
        MOVE WS-READ-BUFFER TO WS-PLAYS-JSON
    ELSE
        PERFORM FETCH-PLAYS
        MOVE WS-PLAYS-PATH TO WS-READ-PATH
        PERFORM READ-FILE-REQUIRED
        MOVE WS-READ-BUFFER TO WS-PLAYS-JSON
    END-IF.

FETCH-PROFILES.
    MOVE SPACES TO WS-COMMAND
    STRING 'curl -fsS -H "Authorization: Bearer '
        FUNCTION TRIM(WS-ACCESS-TOKEN)
        '" -H "Accept: application/json" "'
        FUNCTION TRIM(WS-BASE-URL)
        '/api/v1/profiles" -o "'
        FUNCTION TRIM(WS-PROFILE-PATH)
        '"'
        DELIMITED BY SIZE INTO WS-COMMAND
    PERFORM RUN-COMMAND.

FETCH-PLAYS.
    MOVE SPACES TO WS-COMMAND
    STRING 'curl -fsS -H "Authorization: Bearer '
        FUNCTION TRIM(WS-ACCESS-TOKEN)
        '" -H "Accept: application/json" "'
        FUNCTION TRIM(WS-BASE-URL)
        '/api/v1/plays" -o "'
        FUNCTION TRIM(WS-PLAYS-PATH)
        '"'
        DELIMITED BY SIZE INTO WS-COMMAND
    PERFORM RUN-COMMAND.

RUN-COMMAND.
    MOVE FUNCTION TRIM(WS-COMMAND) TO WS-SYSTEM-COMMAND
    CALL "SYSTEM" USING WS-SYSTEM-COMMAND RETURNING WS-RETURN-CODE
    IF WS-RETURN-CODE NOT = 0
        DISPLAY "MaiTea API request failed" UPON STDERR
        STOP RUN RETURNING 1
    END-IF.

PARSE-PROFILE.
    MOVE WS-PROFILE-JSON TO WS-JSON-SOURCE

    MOVE 1 TO WS-START-POS
    MOVE '"id"' TO WS-KEY
    PERFORM EXTRACT-NUMBER
    IF WS-FOUND = "Y"
        MOVE FUNCTION NUMVAL(WS-NUMERIC-TEXT) TO WS-PROFILE-ID
    END-IF

    MOVE 1 TO WS-START-POS
    MOVE '"name"' TO WS-KEY
    PERFORM EXTRACT-STRING
    IF WS-FOUND = "Y"
        MOVE WS-EXTRACTED TO WS-PROFILE-NAME
    END-IF

    MOVE 1 TO WS-START-POS
    MOVE '"rating"' TO WS-KEY
    PERFORM EXTRACT-NUMBER
    IF WS-FOUND = "Y"
        MOVE FUNCTION NUMVAL(WS-NUMERIC-TEXT) TO WS-PROFILE-RATING
    END-IF

    MOVE 1 TO WS-START-POS
    MOVE '"rating_highest"' TO WS-KEY
    PERFORM EXTRACT-NUMBER
    IF WS-FOUND = "Y"
        MOVE FUNCTION NUMVAL(WS-NUMERIC-TEXT) TO WS-PROFILE-RATING-HIGH
    END-IF

    MOVE 1 TO WS-START-POS
    MOVE '"level"' TO WS-KEY
    PERFORM EXTRACT-NUMBER
    IF WS-FOUND = "Y"
        MOVE FUNCTION NUMVAL(WS-NUMERIC-TEXT) TO WS-PROFILE-LEVEL
    END-IF

    MOVE 1 TO WS-START-POS
    MOVE '"total"' TO WS-KEY
    PERFORM EXTRACT-NUMBER
    IF WS-FOUND = "Y"
        MOVE FUNCTION NUMVAL(WS-NUMERIC-TEXT) TO WS-PROFILE-TOTAL
    END-IF

    MOVE 1 TO WS-START-POS
    MOVE '"png"' TO WS-KEY
    PERFORM EXTRACT-STRING
    IF WS-FOUND = "Y"
        MOVE WS-EXTRACTED TO WS-PROFILE-ICON
    END-IF

    IF FUNCTION TRIM(WS-PROFILE-NAME) = ""
        DISPLAY "No profiles found"
        STOP RUN
    END-IF.

PARSE-PLAYS.
    MOVE WS-PLAYS-JSON TO WS-JSON-SOURCE
    MOVE 1 TO WS-START-POS
    MOVE 0 TO WS-PLAY-COUNT
    PERFORM UNTIL WS-PLAY-COUNT >= WS-SCORE-COUNT
        MOVE '"score_formatted"' TO WS-KEY
        PERFORM EXTRACT-STRING
        IF WS-FOUND NOT = "Y"
            EXIT PERFORM
        END-IF

        ADD 1 TO WS-PLAY-COUNT
        MOVE WS-EXTRACTED TO WS-PLAY-SCORE(WS-PLAY-COUNT)
        MOVE WS-FOUND-POS TO WS-SCAN-POS

        MOVE WS-SCAN-POS TO WS-START-POS
        MOVE '"achievement_formatted"' TO WS-KEY
        PERFORM EXTRACT-STRING
        IF WS-FOUND = "Y"
            MOVE WS-EXTRACTED TO WS-PLAY-ACHIEVEMENT(WS-PLAY-COUNT)
        END-IF

        MOVE WS-SCAN-POS TO WS-START-POS
        MOVE '"rank"' TO WS-KEY
        PERFORM EXTRACT-STRING
        IF WS-FOUND = "Y"
            MOVE WS-EXTRACTED TO WS-PLAY-RANK(WS-PLAY-COUNT)
        END-IF

        MOVE WS-SCAN-POS TO WS-START-POS
        MOVE '"full_combo_label"' TO WS-KEY
        PERFORM EXTRACT-STRING
        IF WS-FOUND = "Y" AND FUNCTION LOWER-CASE(FUNCTION TRIM(WS-EXTRACTED)) NOT = "null"
            MOVE WS-EXTRACTED TO WS-PLAY-FC(WS-PLAY-COUNT)
        END-IF

        MOVE WS-SCAN-POS TO WS-START-POS
        MOVE '"difficulty_level"' TO WS-KEY
        PERFORM FIND-KEY
        IF WS-FOUND = "Y"
            MOVE WS-FOUND-POS TO WS-START-POS
            MOVE '"value"' TO WS-KEY
            PERFORM EXTRACT-STRING
            IF WS-FOUND = "Y"
                MOVE WS-EXTRACTED TO WS-PLAY-DIFF(WS-PLAY-COUNT)
                PERFORM NORMALIZE-DIFFICULTY
                MOVE WS-EXTRACTED TO WS-PLAY-DIFF(WS-PLAY-COUNT)
            END-IF
        END-IF

        MOVE WS-SCAN-POS TO WS-START-POS
        MOVE '"song"' TO WS-KEY
        PERFORM FIND-KEY
        IF WS-FOUND = "Y"
            MOVE WS-FOUND-POS TO WS-START-POS
            MOVE '"en"' TO WS-KEY
            PERFORM EXTRACT-STRING
            IF WS-FOUND = "Y"
                MOVE WS-EXTRACTED TO WS-PLAY-SONG(WS-PLAY-COUNT)
            END-IF
        END-IF

        COMPUTE WS-START-POS = WS-AFTER-POS + 1
    END-PERFORM.

NORMALIZE-DIFFICULTY.
    EVALUATE FUNCTION LOWER-CASE(FUNCTION TRIM(WS-EXTRACTED))
        WHEN "easy"
            MOVE "Easy" TO WS-EXTRACTED
        WHEN "basic"
            MOVE "Basic" TO WS-EXTRACTED
        WHEN "advanced"
            MOVE "Advanced" TO WS-EXTRACTED
        WHEN "expert"
            MOVE "Expert" TO WS-EXTRACTED
        WHEN "master"
            MOVE "Master" TO WS-EXTRACTED
        WHEN "remaster"
            MOVE "Re:Master" TO WS-EXTRACTED
        WHEN "re:master"
            MOVE "Re:Master" TO WS-EXTRACTED
        WHEN "utage"
            MOVE "Utage" TO WS-EXTRACTED
    END-EVALUATE.

PRINT-REPORT.
    COMPUTE WS-RATING = WS-PROFILE-RATING / 100
    COMPUTE WS-RATING-HIGH = WS-PROFILE-RATING-HIGH / 100
    MOVE WS-PROFILE-ID TO WS-ID-TEXT
    MOVE WS-PROFILE-LEVEL TO WS-LEVEL-TEXT
    MOVE WS-PROFILE-TOTAL TO WS-TOTAL-TEXT
    MOVE WS-RATING TO WS-RATING-TEXT
    MOVE WS-RATING-HIGH TO WS-RATING-HIGH-TEXT

    IF WS-LOGO-SIZE > 0
        COMPUTE WS-LOGO-WIDTH = WS-LOGO-SIZE * 2
        MOVE ALL SPACES TO WS-PADDING
    END-IF

    MOVE FUNCTION TRIM(WS-PROFILE-NAME) TO WS-PRINT-LINE
    PERFORM DISPLAY-LINE
    MOVE ALL "-" TO WS-PRINT-LINE(1:FUNCTION LENGTH(FUNCTION TRIM(WS-PROFILE-NAME)))
    PERFORM DISPLAY-LINE

    STRING "ID: " FUNCTION TRIM(WS-ID-TEXT) DELIMITED BY SIZE INTO WS-PRINT-LINE
    PERFORM DISPLAY-LINE
    MOVE SPACES TO WS-PRINT-LINE
    STRING "Rating: " FUNCTION TRIM(WS-RATING-TEXT)
        " / " FUNCTION TRIM(WS-RATING-HIGH-TEXT)
        DELIMITED BY SIZE INTO WS-PRINT-LINE
    PERFORM DISPLAY-LINE
    MOVE SPACES TO WS-PRINT-LINE
    STRING "Level: " FUNCTION TRIM(WS-LEVEL-TEXT) DELIMITED BY SIZE INTO WS-PRINT-LINE
    PERFORM DISPLAY-LINE
    MOVE SPACES TO WS-PRINT-LINE
    STRING "Total Credits: " FUNCTION TRIM(WS-TOTAL-TEXT)
        DELIMITED BY SIZE INTO WS-PRINT-LINE
    PERFORM DISPLAY-LINE
    MOVE "Recent Scores:" TO WS-PRINT-LINE
    PERFORM DISPLAY-LINE

    PERFORM VARYING WS-IDX FROM 1 BY 1 UNTIL WS-IDX > WS-PLAY-COUNT
        MOVE SPACES TO WS-PRINT-LINE
        STRING "  " FUNCTION TRIM(WS-PLAY-SONG(WS-IDX))
            "  " FUNCTION TRIM(WS-PLAY-DIFF(WS-IDX))
            DELIMITED BY SIZE INTO WS-PRINT-LINE
        PERFORM DISPLAY-LINE
        MOVE SPACES TO WS-PRINT-LINE
        STRING "  " FUNCTION TRIM(WS-PLAY-SCORE(WS-IDX))
            " " FUNCTION TRIM(WS-PLAY-ACHIEVEMENT(WS-IDX))
            "% " FUNCTION TRIM(WS-PLAY-RANK(WS-IDX))
            " " FUNCTION TRIM(WS-PLAY-FC(WS-IDX))
            DELIMITED BY SIZE INTO WS-PRINT-LINE
        PERFORM DISPLAY-LINE
        MOVE SPACES TO WS-PRINT-LINE
        PERFORM DISPLAY-LINE
    END-PERFORM.

DISPLAY-LINE.
    IF WS-LOGO-SIZE > 0
        DISPLAY WS-PADDING(1:WS-LOGO-WIDTH) "  " FUNCTION TRIM(WS-PRINT-LINE)
    ELSE
        DISPLAY FUNCTION TRIM(WS-PRINT-LINE)
    END-IF
    MOVE SPACES TO WS-PRINT-LINE.

READ-FILE-OPTIONAL.
    MOVE WS-READ-PATH TO WS-FILE-PATH
    MOVE SPACES TO WS-READ-BUFFER
    MOVE SPACES TO WS-TEMP-BUFFER
    OPEN INPUT DATA-FILE
    IF WS-FILE-STATUS NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM READ-FILE-CONTENTS.

READ-FILE-REQUIRED.
    MOVE WS-READ-PATH TO WS-FILE-PATH
    MOVE SPACES TO WS-READ-BUFFER
    MOVE SPACES TO WS-TEMP-BUFFER
    OPEN INPUT DATA-FILE
    IF WS-FILE-STATUS NOT = "00"
        DISPLAY "could not open " FUNCTION TRIM(WS-READ-PATH) UPON STDERR
        STOP RUN RETURNING 1
    END-IF
    PERFORM READ-FILE-CONTENTS.

READ-FILE-CONTENTS.
    PERFORM UNTIL WS-FILE-STATUS = "10"
        READ DATA-FILE
            AT END
                EXIT PERFORM
            NOT AT END
                MOVE SPACES TO WS-TEMP-BUFFER
                STRING FUNCTION TRIM(WS-READ-BUFFER)
                    FUNCTION TRIM(DATA-LINE)
                    DELIMITED BY SIZE INTO WS-TEMP-BUFFER
                MOVE WS-TEMP-BUFFER TO WS-READ-BUFFER
        END-READ
    END-PERFORM
    CLOSE DATA-FILE.

GET-ENV.
    MOVE SPACES TO WS-ENV-VALUE
    ACCEPT WS-ENV-VALUE FROM ENVIRONMENT WS-ENV-NAME.

FIND-KEY.
    MOVE "N" TO WS-FOUND
    MOVE FUNCTION LENGTH(FUNCTION TRIM(WS-JSON-SOURCE)) TO WS-JSON-LEN
    MOVE FUNCTION LENGTH(FUNCTION TRIM(WS-KEY)) TO WS-KEY-LEN
    IF WS-START-POS < 1
        MOVE 1 TO WS-START-POS
    END-IF
    MOVE WS-START-POS TO WS-SCAN-POS
    PERFORM UNTIL WS-SCAN-POS > WS-JSON-LEN OR WS-FOUND = "Y"
        IF WS-JSON-SOURCE(WS-SCAN-POS:WS-KEY-LEN) = WS-KEY(1:WS-KEY-LEN)
            MOVE "Y" TO WS-FOUND
            MOVE WS-SCAN-POS TO WS-FOUND-POS
        ELSE
            ADD 1 TO WS-SCAN-POS
        END-IF
    END-PERFORM.

EXTRACT-STRING.
    MOVE SPACES TO WS-EXTRACTED
    PERFORM FIND-KEY
    IF WS-FOUND NOT = "Y"
        EXIT PARAGRAPH
    END-IF
    COMPUTE WS-SCAN-POS = WS-FOUND-POS + WS-KEY-LEN
    PERFORM UNTIL WS-SCAN-POS > WS-JSON-LEN
        OR WS-JSON-SOURCE(WS-SCAN-POS:1) = ":"
        ADD 1 TO WS-SCAN-POS
    END-PERFORM
    ADD 1 TO WS-SCAN-POS
    PERFORM UNTIL WS-SCAN-POS > WS-JSON-LEN
        OR WS-JSON-SOURCE(WS-SCAN-POS:1) NOT = " "
        ADD 1 TO WS-SCAN-POS
    END-PERFORM
    IF WS-JSON-SOURCE(WS-SCAN-POS:1) = QUOTE
        ADD 1 TO WS-SCAN-POS
        MOVE 1 TO WS-OUT-POS
        PERFORM UNTIL WS-SCAN-POS > WS-JSON-LEN
            OR WS-JSON-SOURCE(WS-SCAN-POS:1) = QUOTE
            MOVE WS-JSON-SOURCE(WS-SCAN-POS:1) TO WS-EXTRACTED(WS-OUT-POS:1)
            ADD 1 TO WS-SCAN-POS
            ADD 1 TO WS-OUT-POS
        END-PERFORM
        ADD 1 TO WS-SCAN-POS
    ELSE
        MOVE 1 TO WS-OUT-POS
        PERFORM UNTIL WS-SCAN-POS > WS-JSON-LEN
            OR WS-JSON-SOURCE(WS-SCAN-POS:1) = ","
            OR WS-JSON-SOURCE(WS-SCAN-POS:1) = "}"
            OR WS-JSON-SOURCE(WS-SCAN-POS:1) = "]"
            MOVE WS-JSON-SOURCE(WS-SCAN-POS:1) TO WS-EXTRACTED(WS-OUT-POS:1)
            ADD 1 TO WS-SCAN-POS
            ADD 1 TO WS-OUT-POS
        END-PERFORM
    END-IF
    MOVE WS-SCAN-POS TO WS-AFTER-POS.

EXTRACT-NUMBER.
    MOVE SPACES TO WS-NUMERIC-TEXT
    PERFORM FIND-KEY
    IF WS-FOUND NOT = "Y"
        EXIT PARAGRAPH
    END-IF
    COMPUTE WS-SCAN-POS = WS-FOUND-POS + WS-KEY-LEN
    PERFORM UNTIL WS-SCAN-POS > WS-JSON-LEN
        OR WS-JSON-SOURCE(WS-SCAN-POS:1) = ":"
        ADD 1 TO WS-SCAN-POS
    END-PERFORM
    ADD 1 TO WS-SCAN-POS
    PERFORM UNTIL WS-SCAN-POS > WS-JSON-LEN
        OR WS-JSON-SOURCE(WS-SCAN-POS:1) NOT = " "
        ADD 1 TO WS-SCAN-POS
    END-PERFORM
    MOVE 1 TO WS-OUT-POS
    PERFORM UNTIL WS-SCAN-POS > WS-JSON-LEN
        OR WS-JSON-SOURCE(WS-SCAN-POS:1) = ","
        OR WS-JSON-SOURCE(WS-SCAN-POS:1) = "}"
        OR WS-JSON-SOURCE(WS-SCAN-POS:1) = "]"
        OR WS-JSON-SOURCE(WS-SCAN-POS:1) = " "
        MOVE WS-JSON-SOURCE(WS-SCAN-POS:1) TO WS-NUMERIC-TEXT(WS-OUT-POS:1)
        ADD 1 TO WS-SCAN-POS
        ADD 1 TO WS-OUT-POS
    END-PERFORM
    MOVE WS-SCAN-POS TO WS-AFTER-POS.

PRINT-HELP.
    DISPLAY "Usage: maifetch [options]"
    DISPLAY "  --access-token, -a, -t TOKEN   MaiTea access token"
    DISPLAY "  --logo-size, -l SIZE           ASCII logo size; 0 disables"
    DISPLAY "  --score-count, -s COUNT        recent scores to show, max 12"
    DISPLAY "  --config-file, -c PATH         JSON config file"
    DISPLAY "  --help, -h                     show this help".
